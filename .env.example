# Environment Variables for NEXIAL AI Platform

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
# Get these from: https://supabase.com/dashboard/project/[project-id]/settings/database
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-ID].supabase.co:5432/postgres"
DATABASE_DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-ID].supabase.co:5432/postgres"

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-key-minimum-32-characters"

# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSWORD_SALT_ROUNDS=10

# ============================================
# EMAIL SERVICE (Resend)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL="noreply@nexial.ai"

# Admin email for receiving new application notifications
ADMIN_EMAIL="admissions@nexial.ai"

# ============================================
# APPLICATION CONFIG
# ============================================
# For local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# For production (update with your Vercel URL or custom domain)
# NEXT_PUBLIC_APP_URL="https://ai-masters-platform.vercel.app"
# NEXT_PUBLIC_APP_URL="https://nexial.ai"

# ============================================
# SECURITY
# ============================================
# Rate limiting: max requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://ai-masters-platform.vercel.app"
